# === Momo Collective - Environment Variables ===
# Copy this file to .env and fill in your values.
# For Vercel deployment, set these in the Vercel dashboard under Settings > Environment Variables.

# --- Frontend (Vite) ---
# OAuth portal URL (optional - leave empty to use /auth local page instead)
VITE_OAUTH_PORTAL_URL=
# OAuth App ID (optional)
VITE_APP_ID=

# --- Backend ---
# MySQL connection string
DATABASE_URL=mysql://user:password@host:3306/momo_collective

# JWT secret for session signing (generate with: openssl rand -base64 32)
JWT_SECRET=

# AWS S3 for product image uploads (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
