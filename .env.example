# === Momo Collective - Environment Variables ===
# Copy to .env and fill values. On Vercel: Settings > Environment Variables.
# NEVER commit the real .env file (already in .gitignore).

# --- Runtime ---
NODE_ENV=production

# --- Frontend (Vite, exposed to browser — no secrets here) ---
# OAuth portal URL (optional — leave empty to use the local /auth page)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# --- Backend (server-only secrets — NOT exposed to the browser) ---
# MySQL connection string
DATABASE_URL=mysql://user:password@host:3306/momo_collective

# Session signing secret (generate: openssl rand -base64 32)
JWT_SECRET=

# OAuth server (backend)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Forge platform API (image gen / LLM / maps proxy)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
