# === Momo Collective — Environment Variables ===
# Copy to .env locally; set these in the Vercel dashboard for production.
# NEVER commit the real .env (already in .gitignore).

# --- Runtime ---
NODE_ENV=production

# --- Database (Neon Postgres) ---
# Get from Neon dashboard → Connection string (use the POOLED connection for serverless)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/momo?sslmode=require

# --- Order notification email (Gmail SMTP) ---
# GMAIL_APP_PASSWORD is a Google "App Password" (16 chars), NOT your account password.
# Create one: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=yourbrand@gmail.com
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=mizohazembargal@gmail.com

# --- Admin dashboard access ---
# Shared secret for the /admin dashboard + /api/admin/* routes.
# Generate a strong one: openssl rand -base64 32
ADMIN_TOKEN=

# --- Paymob (online payments — Phase 2, not required for COD launch) ---
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_HMAC_SECRET=

# --- Frontend (Vite, exposed to browser — no secrets) ---
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
